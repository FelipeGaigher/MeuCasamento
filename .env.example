# Banco. No Neon, `neon env pull` (ou `neon deploy`) preenche os dois:
# DATABASE_URL e o pooled (-pooler), usado pela app; DATABASE_URL_UNPOOLED e a
# conexao direta, usada so pelas migracoes. Localmente os dois podem ser iguais.
DATABASE_URL="postgresql://meucasamento:meucasamento@localhost:5432/meucasamento"
DATABASE_URL_UNPOOLED="postgresql://meucasamento:meucasamento@localhost:5432/meucasamento"

# Sessao (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-longo"
# Assinatura dos links de convidado (gere outro valor)
GUEST_LINK_SECRET="troque-por-outro-segredo-longo"

# URL publica, usada nos links enviados por WhatsApp e e-mail
APP_URL="http://localhost:3000"

# Asaas (conta da plataforma). Sem chave, o checkout roda em modo demonstracao.
ASAAS_API_KEY=""
ASAAS_SANDBOX="true"
# Token configurado no webhook do Asaas (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=""

# Taxa da plataforma em pontos-base (350 = 3,5%) e taxa minima em centavos
PLATFORM_FEE_BPS="350"
PLATFORM_MIN_FEE_CENTS="300"

# Evolution (WhatsApp para o casal)
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""

# Brevo (e-mail transacional)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="ola@meucasamento.app"
BREVO_SENDER_NAME="Meu Casamento"
